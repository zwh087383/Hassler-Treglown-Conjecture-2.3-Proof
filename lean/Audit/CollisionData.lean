import Audit.Weights

namespace Audit.CollisionData
open Bipartite Finset
abbrev Relation := Finset (Fin 7 × Fin 7)
def eqRel {A : Type*} [DecidableEq A] (t : Fin 7 → A) : Relation :=
  univ.filter fun p => t p.1=t p.2

structure Cert where
  width : Nat
  slot : Fin 7 → Fin width
  rep : Fin width → Fin 7
  a : Fin width → State → ℚ
  extra : State → ℚ

