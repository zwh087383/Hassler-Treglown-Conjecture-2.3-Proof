private def hi : Finset P := (univ.erase 0 |>.erase 2 |>.erase 3)
private theorem checked : verify ({1,4} : Finset P) hi node634=true := by native_decide

theorem normal_plane (w : P → ℕ) (q : ℕ) (h : Weights w q)
    (zero : w 0=0) (two : w 2=0) (three : w 3=0) :
    ∃ b : Fin 5, ∀ i,0<w i → line b i=true := by
  apply sound w q h node634 _ _ _ _ checked
  · have axis := h.axis; have f := h.cap 1; have g := h.cap 4
    intro i hi; rcases (show i=1 ∨ i=4 by simpa using hi) with rfl|rfl <;> omega
  · intro i pos
    have a : i≠0 := fun e => (e ▸ pos : 0<w 0).ne' zero
    have c : i≠2 := fun e => (e ▸ pos : 0<w 2).ne' two
    have d : i≠3 := fun e => (e ▸ pos : 0<w 3).ne' three
    simp [hi,a,c,d]

end Audit.PlaneData
