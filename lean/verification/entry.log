'Audit.DefinitionCheck.paper_statement' depends on axioms: [propext, Classical.choice, Lean.ofReduceBool, Quot.sound]
Audit.Sharp.upper {η : ℝ} (positive : 0 < η) (small : η ≤ 1) :
  ∀ᶠ (k : ℕ) in Filter.atTop,
    ↑(Audit.Asymptotic.fmax (k + 1)) ≤
      2 ^ (2 * η * Audit.Assembly.order k) * 3 ^ (Audit.Assembly.order k / 10 + Audit.Blocks.errorConstant)
Audit.Sharp.log_limit :
  Filter.Tendsto (fun k => Real.logb 3 ↑(Audit.Link.maximalSets Finset.univ).card / 5 ^ k) Filter.atTop (nhds (1 / 10))
Audit.Sharp.main_theorem :
  ∃ e,
    (e =o[Filter.atTop] fun k => 5 ^ k) ∧ ∀ (k : ℕ), ↑(Audit.Link.maximalSets Finset.univ).card = 3 ^ (5 ^ k / 10 + e k)
Audit.DefinitionCheck.paper_statement :
  ∃ e,
    (e =o[Filter.atTop] fun k => 5 ^ k) ∧
      ∀ (k : ℕ), ↑(Audit.DefinitionCheck.paperFamily (Fin k → ZMod 5)).card = 3 ^ (5 ^ k / 10 + e k)
